          {
            "id": "t1",
            "title": "Credential Stuffing",
            "type": "Spoofing",
            "description": "Attackers use stolen or reused credentials to gain unauthorized access to user accounts.",
            "severity": "High",
            "target": "1",
            "mitigation": "Enforce strong password policies, enable multi-factor authentication (MFA), implement account lockout, and monitor for credential reuse.",
            "status": "Mitigated"
          },
          {
            "id": "t2",
            "title": "Tampering With Transactions",
            "type": "Tampering",
            "description": "Unauthorized modification of transaction data during communication between the client and the payment gateway.",
            "severity": "High",
            "target": "f4",
            "mitigation": "Use end-to-end encryption (TLS), validate transaction data integrity using MACs or digital signatures.",
            "status": "Mitigated"
          },
          {
            "id": "t3",
            "title": "Data Leak from Database",
            "type": "Information Disclosure",
            "description": "Exposure of sensitive personal and financial data due to inadequate encryption or access control in the database.",
            "severity": "Critical",
            "target": "4",
            "mitigation": "Encrypt all sensitive data at rest, apply strict access controls, use database activity monitoring.",
            "status": "Mitigated"
          },
          {
            "id": "t4",
            "title": "Lack of Audit Logs",
            "type": "Repudiation",
            "description": "Inadequate logging of user activity prevents accountability and detection of fraud or misuse.",
            "severity": "Medium",
            "target": "2",
            "mitigation": "Implement comprehensive, tamper-evident logging for all critical actions and store logs securely.",
            "status": "Mitigated"
          },
          {
            "id": "t5",
            "title": "API Abuse - Denial of Service",
            "type": "Denial of Service",
            "description": "Exploitation of the public API by flooding it with requests, leading to degraded performance or downtime.",
            "severity": "Medium",
            "target": "5",
            "mitigation": "Implement rate limiting, IP throttling, WAF rules, and behavior-based anomaly detection.",
            "status": "Mitigated"
          },
          {
            "id": "t6",
            "title": "Session Hijacking via XSS",
            "type": "Elevation of Privilege",
            "description": "Attackers exploit XSS vulnerabilities to steal session tokens and impersonate users.",
            "severity": "High",
            "target": "2",
            "mitigation": "Sanitize user input, apply output encoding, use secure, HTTP-only cookies with SameSite attributes, and implement CSP headers.",
            "status": "Mitigated"
          }
        ]
      }
